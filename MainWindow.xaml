<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="听页 · EPUB 听书" Width="1160" Height="780" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True" Language="zh-CN">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#213A31" />
    <SolidColorBrush x:Key="Muted" Color="#55675D" />
    <SolidColorBrush x:Key="Paper" Color="#FAF8F1" />
    <SolidColorBrush x:Key="Forest" Color="#203B32" />
    <SolidColorBrush x:Key="SidebarText" Color="#F6F4E9" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#B4C7BC" />
    <SolidColorBrush x:Key="Accent" Color="#315D4D" />
    <SolidColorBrush x:Key="AccentLine" Color="#538469" />
    <SolidColorBrush x:Key="PrimaryFill" Color="#315D4D" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusRing" Color="#BD744C" />
    <SolidColorBrush x:Key="Surface" Color="#FDFCFA" />
    <SolidColorBrush x:Key="Soft" Color="#EDF0E7" />
    <SolidColorBrush x:Key="Selection" Color="#E8EFE2" />
    <SolidColorBrush x:Key="Line" Color="#D5DACE" />
    <SolidColorBrush x:Key="SideHover" Color="#355447" />
    <SolidColorBrush x:Key="SideSelection" Color="#416653" />
    <SolidColorBrush x:Key="SideFocus" Color="#ADCEAF" />
    <SolidColorBrush x:Key="NoticeFill" Color="#FFF1DD" />
    <SolidColorBrush x:Key="NoticeLine" Color="#DFC2A2" />
    <SolidColorBrush x:Key="NoticeText" Color="#69432D" />
    <SolidColorBrush x:Key="ErrorText" Color="#B22222" />
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.80" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.64" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Background" Value="{DynamicResource PrimaryFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryFill}" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{DynamicResource Soft}" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Height" Value="39" />
      <Setter Property="Width" Value="42" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Height" Value="33" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PlayerChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Option" Padding="10,7" Margin="2,1" Background="Transparent" CornerRadius="5">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Option" Property="Background" Value="{DynamicResource Selection}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                <DockPanel Margin="9,0">
                  <Path DockPanel.Dock="Right" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  <ContentPresenter VerticalAlignment="Center" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    IsHitTestVisible="False"/>
                </DockPanel>
              </Border>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup Name="PART_Popup" Placement="Bottom" VerticalOffset="3" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, ElementName=Face}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3"
                        Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="17"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" SnapsToDevicePixels="True">
                  <Border x:Name="Rail" Width="8" Margin="0,2" CornerRadius="4" Opacity=".26"
                          Background="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
                  <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.Resources>
                      <!-- WPF uses half this resource as the minimum thumb length. -->
                      <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">80</sys:Double>
                    </Track.Resources>
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb>
                      <Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"><Border x:Name="Grip" Width="8" Margin="0,2" CornerRadius="4"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Opacity=".82"/></Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="Width" Value="10"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="Width" Value="10"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate></Thumb.Template>
                    </Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Opacity" Value=".4"/></Trigger>
                  <Trigger SourceName="PART_Track" Property="Visibility" Value="Hidden"><Setter TargetName="Rail" Property="Visibility" Value="Hidden"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FlatList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>
    <Style x:Key="ChapterDisclosure" TargetType="ToggleButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="ToolTip" Value="展开目录" />
      <Setter Property="automation:AutomationProperties.Name" Value="展开目录" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
              <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource SidebarText}" StrokeThickness="1.7"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource SideHover}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SideFocus}" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 4,4 L 8,0" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="ToolTip" Value="收起目录" />
          <Setter Property="automation:AutomationProperties.Name" Value="收起目录" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ChapterItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
      <Setter Property="automation:AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Padding="{Binding Padding}" Margin="0,1,5,1" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
              <DockPanel>
                <ToggleButton x:Name="Disclosure" DockPanel.Dock="Left" Style="{StaticResource ChapterDisclosure}"
                              IsChecked="{Binding IsExpanded, Mode=OneWay}" Visibility="Hidden" />
                <TextBlock x:Name="ChildCount" DockPanel.Dock="Right" Text="{Binding ChildrenCount}" Visibility="Collapsed"
                           Foreground="{DynamicResource SidebarMuted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,2,0" />
                <TextBlock x:Name="Heading" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" ToolTip="{Binding Title}" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SideHover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SideSelection}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SideFocus}" /></Trigger>
              <DataTrigger Binding="{Binding HasChildren}" Value="True">
                <Setter TargetName="Disclosure" Property="Visibility" Value="Visible" />
                <Setter TargetName="ChildCount" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSection}" Value="True">
                <Setter TargetName="Heading" Property="FontSize" Value="12" />
                <Setter TargetName="Heading" Property="FontWeight" Value="Normal" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PassageItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="0,0,9,8" Padding="17,8,15,8" BorderBrush="Transparent" BorderThickness="3,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="{DynamicResource ReadingNotesWidth}" MaxWidth="300" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="SectionHeading" Text="{Binding SectionHeading}" FontSize="{DynamicResource ReadingHeadingSize}" FontFamily="{DynamicResource ReadingFamily}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6" />
                  <TextBlock x:Name="PassageText" Text="{Binding Text}" FontSize="{DynamicResource ReadingSize}" FontFamily="{DynamicResource ReadingFamily}" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="{DynamicResource ReadingLineHeight}" Foreground="{DynamicResource Ink}" />
                </StackPanel>
                <ItemsControl x:Name="PassageNotes" Grid.Column="1" Margin="16,1,0,0" VerticalAlignment="Top"
                              Visibility="{DynamicResource ReadingNotesVisibility}" ItemsSource="{Binding Notes}"
                              automation:AutomationProperties.Name="本段注释">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource AccentLine}" BorderThickness="2,0,0,0" Padding="9,2,4,3" Margin="0,0,0,7">
                        <TextBlock Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource ReadingFamily}" TextWrapping="Wrap">
                          <Run Text="{Binding Marker, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" />
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Soft}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentLine}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
              <DataTrigger Binding="{Binding SectionHeading}" Value="{x:Null}"><Setter TargetName="SectionHeading" Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding IsHeadingText}" Value="True"><Setter TargetName="PassageText" Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding Notes}" Value="{x:Null}"><Setter TargetName="PassageNotes" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSpacer}" Value="True">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Height="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, FallbackValue=0}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShelfTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabFace" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{DynamicResource Soft}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ShelfAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="Background" Value="{DynamicResource Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,5">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                      Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Muted}" Margin="0,0,8,0">
                <Path x:Name="Tick" Data="M0,4 L3,7 L9,0" Stretch="Uniform" Width="9" Stroke="{DynamicResource PrimaryText}"
                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryFill}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ContextMenu x:Key="BookActions" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Template>
              <ControlTemplate TargetType="ContextMenu">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
                  <ItemsPresenter />
                </Border>
              </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
              <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Border x:Name="Face" Background="Transparent" CornerRadius="4" Padding="12,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ContextMenu.Resources>
            <MenuItem Header="修改显示书名…" Command="ApplicationCommands.Properties" CommandParameter="{Binding Entry}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
            <MenuItem Header="{Binding ReadAction}" Command="{Binding ReadCommand}" CommandParameter="{Binding Entry}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
            <MenuItem Header="删除书籍…" Command="{Binding DeleteCommand}" CommandParameter="{Binding Entry}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
    </ContextMenu>
    <DataTemplate x:Key="ShelfBook">
      <Button Height="260" Margin="0,0,10,1" Padding="10,8" Style="{StaticResource BaseButton}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}" Cursor="Hand"
              ContextMenu="{StaticResource BookActions}" CommandParameter="{Binding Entry}" ToolTip="{Binding Description}" automation:AutomationProperties.Name="{Binding Title}">
        <StackPanel Width="146">
          <Border x:Name="ShelfCover" Width="112" Height="148" Margin="0,0,0,12" HorizontalAlignment="Center" Background="{Binding Color}"
                  BorderBrush="#66314739" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid>
              <Border BorderBrush="#70FFFFFF" BorderThickness="1" Margin="11,14,8,14" Padding="6">
                <TextBlock Text="{Binding Title}" MaxHeight="96" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" FontFamily="SimSun" FontSize="17" FontWeight="Bold"
                           Foreground="#FFFAED" VerticalAlignment="Center" />
              </Border>
              <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              <Border HorizontalAlignment="Left" Width="5" Background="#30000000" />
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="6,2" CornerRadius="4" Background="{DynamicResource PrimaryFill}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="已读" FontSize="11" Foreground="{DynamicResource PrimaryText}" />
              </Border>
            </Grid>
          </Border>
          <Grid Height="40">
            <TextBlock Text="{Binding Title}" MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          </Grid>
          <TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis" FontSize="12"
                     Foreground="{DynamicResource Muted}" FontWeight="Normal" Margin="0,2,0,0" />
          <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                     FontWeight="Normal" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="AuthorBook">
      <Button Height="60" Margin="0,0,6,3" Padding="12,4" Style="{StaticResource BaseButton}" HorizontalContentAlignment="Stretch"
              ContextMenu="{StaticResource BookActions}" CommandParameter="{Binding Entry}" ToolTip="{Binding Description}"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" automation:AutomationProperties.Name="{Binding Title}">
        <DockPanel>
          <Border x:Name="ShelfCover" DockPanel.Dock="Left" Width="33" Height="44" Background="{Binding Color}" CornerRadius="2" Margin="0,0,14,0">
            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
          </Border>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock x:Name="ReadBadge" DockPanel.Dock="Right" Text="已读" Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Button>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsRead}" Value="True"><Setter TargetName="ReadBadge" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="ShelfRow">
      <StackPanel x:Name="RowLayout" Margin="0,0,0,14">
        <DockPanel Margin="0,9,8,6">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Heading}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold" />
        </DockPanel>
        <ItemsControl x:Name="BookItems" ItemsSource="{Binding Books}" ItemTemplate="{StaticResource ShelfBook}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ByAuthor}" Value="True">
          <Setter TargetName="BookItems" Property="ItemTemplate" Value="{StaticResource AuthorBook}"/>
          <Setter TargetName="RowLayout" Property="Margin" Value="0,0,0,2"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{DynamicResource Paper}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False" Margin="4,10,4,8">
        <Button x:Name="ExpandNav" DockPanel.Dock="Top" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Width="35" Height="35" Padding="8" ToolTip="展开侧栏" automation:AutomationProperties.Name="展开侧栏">
          <Path Data="M2,3 H20 V19 H2 Z M8,3 V19" Stretch="Uniform" Width="16" Height="15" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
        </Button>
        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="ReaderNav" GroupName="MainNavigation" Style="{StaticResource ShelfTab}" Padding="5,7" MinHeight="36" Margin="0,2" ToolTip="阅读" automation:AutomationProperties.Name="阅读">
            <StackPanel Orientation="Horizontal"><Path Data="M2,4 Q7,2 12,5 Q17,2 22,4 V19 Q17,17 12,20 Q7,17 2,19 Z M12,5 V20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ReadNavLabel" Text="阅读" Visibility="Collapsed" VerticalAlignment="Center" FontSize="13" Margin="8,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ShelfButton" GroupName="MainNavigation" Style="{StaticResource ShelfTab}" Padding="5,7" MinHeight="36" Margin="0,2" ToolTip="书架" automation:AutomationProperties.Name="书架" IsChecked="True">
            <StackPanel Orientation="Horizontal"><Path Data="M3,20 H22 M4,17 V4 H8 V17 Z M10,17 V5 H13 V17 Z M15,6 L18,5 L21,16 L18,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ShelfNavLabel" Text="书架" Visibility="Collapsed" VerticalAlignment="Center" FontSize="13" Margin="8,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" GroupName="MainNavigation" Style="{StaticResource ShelfTab}" Padding="5,7" MinHeight="36" Margin="0,2" ToolTip="设置" automation:AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal"><Path Data="M10,2 H14 L14.6,4.5 L16.7,5.6 L19.2,4.8 L21.2,8.2 L19.3,10 V13 L21.2,15 L19.2,18.4 L16.7,17.6 L14.6,18.8 L14,21.5 H10 L9.4,18.8 L7.3,17.6 L4.8,18.4 L2.8,15 L4.7,13 V10 L2.8,8.2 L4.8,4.8 L7.3,5.6 L9.4,4.5 Z M15.5,11.8 A3.5,3.5 0 1 1 8.5,11.8 A3.5,3.5 0 1 1 15.5,11.8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SettingsNavLabel" Text="设置" Visibility="Collapsed" VerticalAlignment="Center" FontSize="13" Margin="8,0,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="BookshelfPage" Grid.Row="0" Margin="32,25,32,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="OpenBooksFolder" Content="打开文件夹" Style="{StaticResource ShelfAction}" Margin="0,0,6,0" />
          <Button x:Name="ScanBooksFolder" Content="扫描文件夹" Style="{StaticResource ShelfAction}" Margin="0,0,6,0" />
          <Button x:Name="ImportButton" Content="导入 EPUB" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,6" ToolTip="Ctrl+O"/>
        </StackPanel>
        <Button x:Name="ResumeBookButton" DockPanel.Dock="Right" Content="继续阅读" Style="{StaticResource ShelfAction}"
                Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" Padding="16,7" VerticalAlignment="Center" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ShelfTitle" Text="书架" FontSize="36" FontWeight="SemiBold" FontFamily="SimSun" VerticalAlignment="Center" />
          <TextBlock x:Name="BookCount" FontSize="13" Margin="13,0,0,2" VerticalAlignment="Bottom" Foreground="{DynamicResource Muted}" />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,17">
        <Grid.Style>
          <Style TargetType="Grid"><Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=EmptyBookshelf}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style>
        </Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="ShelfAll" GroupName="ShelfView" Content="全部书籍" IsChecked="True" Style="{StaticResource ShelfTab}" />
          <RadioButton x:Name="ShelfAuthors" GroupName="ShelfView" Content="按作者" Margin="4,0,0,0" Style="{StaticResource ShelfTab}" />
        </StackPanel>
        <Border Grid.Column="1" MaxWidth="380" Height="36" Margin="18,0,16,0" Padding="10,0,3,0"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="33"/></Grid.ColumnDefinitions>
            <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 M 12,12 L 17,17" IsHitTestVisible="False" />
            <TextBox x:Name="ShelfSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                     VerticalContentAlignment="Center" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}"
                     automation:AutomationProperties.Name="搜索书名或作者" ToolTip="Ctrl+F" />
            <TextBlock Grid.Column="1" Text="搜索书名或作者" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=ShelfSearch}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ClearShelfSearch" Grid.Column="2" Content="×" Style="{StaticResource BaseButton}"
                    FontSize="16" Padding="0" Width="29" Height="28" Background="{DynamicResource Surface}"
                    automation:AutomationProperties.Name="清除搜索" ToolTip="清除搜索" Visibility="Collapsed" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ComboBox x:Name="ShelfReadFilter" Style="{StaticResource PlayerChoice}" Width="105" Height="36" Margin="0,0,12,0" automation:AutomationProperties.Name="阅读状态筛选">
            <ComboBoxItem Content="全部状态" /><ComboBoxItem Content="已读" /><ComboBoxItem Content="未读" />
          </ComboBox>
          <Label Content="排序" Target="{Binding ElementName=ShelfSort}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Muted}" />
          <ComboBox x:Name="ShelfSort" Style="{StaticResource PlayerChoice}" Width="112" Height="36" automation:AutomationProperties.Name="书架排序">
            <ComboBoxItem Content="最近导入" /><ComboBoxItem Content="最近阅读" />
          </ComboBox>
        </StackPanel>
      </Grid>
      <ListBox x:Name="ShelfRows" Grid.Row="2" Style="{StaticResource FlatList}" ItemTemplate="{StaticResource ShelfRow}"
               ScrollViewer.VerticalScrollBarVisibility="Auto" automation:AutomationProperties.Name="书架书籍">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <StackPanel x:Name="EmptyBookshelf" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="书架还没有书" TextAlignment="Center" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="导入 EPUB，或把文件放进书籍文件夹后扫描。" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,9,0,19" />
        <Button x:Name="WelcomeImport" Content="导入 EPUB" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="NoShelfMatches" Grid.Row="2" Text="没有找到匹配的书籍" FontSize="19"
                 Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>

    <Grid x:Name="ReaderArea" Grid.Row="0" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="InfoColumn" Width="0"/><ColumnDefinition x:Name="DividerColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="BookInfo" Visibility="Collapsed" Background="{DynamicResource Forest}" Padding="15,14,7,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,5,13">
            <TextBlock Text="当前书籍" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" />
          </DockPanel>
          <ComboBox x:Name="Shelf" Grid.Row="1" Style="{StaticResource PlayerChoice}" DisplayMemberPath="DisplayTitle" automation:AutomationProperties.Name="书架选书" Margin="0,0,5,0" />
          <Grid Grid.Row="2" Margin="0,12,5,13">
            <Grid x:Name="BookCard" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="56" Height="76" HorizontalAlignment="Left" ClipToBounds="True" CornerRadius="4" Background="{DynamicResource SideSelection}">
                <Grid>
                  <Border BorderBrush="{DynamicResource SideFocus}" BorderThickness="1" Margin="6" CornerRadius="2">
                    <TextBlock x:Name="CoverLetter" Foreground="{DynamicResource SidebarText}" FontFamily="SimSun" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="BookTitle" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" FontSize="15" />
                <TextBlock x:Name="BookAuthor" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SidebarMuted}" FontSize="12" Margin="0,7,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,0,5,8">
            <TextBlock x:Name="ChapterCount" DockPanel.Dock="Right" Foreground="{DynamicResource SidebarMuted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Text="章节目录" Foreground="{DynamicResource SidebarText}" FontWeight="SemiBold" />
          </DockPanel>
          <ListBox x:Name="Chapters" Grid.Row="4" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource ChapterItem}"
                   automation:AutomationProperties.Name="章节目录">
            <ListBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Setter Property="Foreground" Value="{DynamicResource SidebarMuted}"/></Style>
            </ListBox.Resources>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter x:Name="InfoDivider" Visibility="Collapsed" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Line}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                    ToolTip="拖动调整目录宽度" automation:AutomationProperties.Name="调整目录宽度" />
      <Grid x:Name="TextHost" Grid.Column="2" Margin="0,0,44,0">
        <Grid x:Name="Reader" Margin="14,20,14,0" MaxWidth="870" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="3,0,12,13">
            <TextBlock x:Name="ReaderPosition" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right" />
            <TextBlock x:Name="ReaderBookTitle" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="13" />
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="2,0,11,11">
            <TextBlock x:Name="ChapterTitle" FontFamily="SimSun" FontSize="33" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="81" />
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,17,0,0" />
          </StackPanel>
          <ListBox x:Name="Passages" Grid.Row="2" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource PassageItem}"
                   FocusVisualStyle="{x:Null}" automation:AutomationProperties.Name="正文，选择段落定位">
            <ListBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                <Setter Property="Opacity" Value="0"/>
              </Style>
            </ListBox.Resources>
          </ListBox>
        </Grid>
      </Grid>
    </Grid>

    <StackPanel x:Name="EmptyReader" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="选择一本书开始阅读" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
      <Button x:Name="ChooseBook" Content="前往书架" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
    </StackPanel>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Margin="32,25" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,28">
          <Button x:Name="OpenShortcuts" DockPanel.Dock="Right" Content="快捷键 ›" VerticalAlignment="Center" Style="{StaticResource ShelfAction}" />
          <TextBlock Text="设置" FontFamily="SimSun" FontWeight="SemiBold" FontSize="36"/>
        </DockPanel>
        <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
          <StackPanel>
            <DockPanel Margin="16,12"><Border DockPanel.Dock="Right"><ComboBox x:Name="ThemeChoice" DisplayMemberPath="Label" Width="190" Style="{StaticResource PlayerChoice}" automation:AutomationProperties.Name="界面配色"/></Border><TextBlock Text="界面配色" VerticalAlignment="Center"/></DockPanel>
            <Border Height="1" Margin="16,0" Background="{DynamicResource Line}"/>
            <DockPanel Margin="16,12">
              <CheckBox x:Name="AnimateBookOpening" DockPanel.Dock="Right" Width="190" Content="开启" Style="{StaticResource SettingsCheckBox}"
                        VerticalAlignment="Center" automation:AutomationProperties.Name="开书动画"/>
              <TextBlock Text="开书动画" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="阅读文字" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/>
        <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
          <StackPanel>
            <DockPanel Margin="16,12"><ComboBox x:Name="ReadingFont" DockPanel.Dock="Right" Width="190" Style="{StaticResource PlayerChoice}" automation:AutomationProperties.Name="正文字体"/><TextBlock Text="正文字体" VerticalAlignment="Center"/></DockPanel>
            <Border Height="1" Margin="16,0" Background="{DynamicResource Line}"/>
            <DockPanel Margin="16,12"><ComboBox x:Name="ReadingFontSize" DockPanel.Dock="Right" Width="190" Style="{StaticResource PlayerChoice}" automation:AutomationProperties.Name="正文字号"/><TextBlock Text="正文字号" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="山静日长，翻书有声。" FontFamily="{DynamicResource ReadingFamily}" FontSize="{DynamicResource ReadingSize}" Margin="16,0,16,14" Foreground="{DynamicResource Ink}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="播放栏" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/>
        <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
          <StackPanel>
            <DockPanel Margin="16,12">
              <CheckBox x:Name="AutoHidePlayer" DockPanel.Dock="Right" Content="开启" Style="{StaticResource SettingsCheckBox}"
                        Width="190" VerticalAlignment="Center" automation:AutomationProperties.Name="自动隐藏播放栏"/>
              <TextBlock Text="自动隐藏播放栏" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Height="1" Margin="16,0" Background="{DynamicResource Line}"/>
            <DockPanel Margin="16,12">
              <ComboBox x:Name="PlayerHideDelay" DockPanel.Dock="Right" Width="190" Style="{StaticResource PlayerChoice}"
                        DisplayMemberPath="Value" SelectedValuePath="Key" IsEnabled="{Binding IsChecked, ElementName=AutoHidePlayer}"
                        automation:AutomationProperties.Name="播放栏隐藏等待时间"/>
              <TextBlock Text="隐藏前等待" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="朗读" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/>
        <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
          <StackPanel>
            <DockPanel Margin="16,12"><Border DockPanel.Dock="Right"><ComboBox x:Name="Voices" DisplayMemberPath="Label" Width="190" Style="{StaticResource PlayerChoice}" automation:AutomationProperties.Name="朗读语音"/></Border><TextBlock Text="朗读语音" VerticalAlignment="Center"/></DockPanel>
            <Border Height="1" Margin="16,0" Background="{DynamicResource Line}"/>
            <DockPanel Margin="16,12"><Border DockPanel.Dock="Right"><ComboBox x:Name="Speeds" DisplayMemberPath="Label" Width="190" Style="{StaticResource PlayerChoice}" automation:AutomationProperties.Name="朗读语速"/></Border><TextBlock Text="朗读语速" VerticalAlignment="Center"/></DockPanel>
            <Border Height="1" Margin="16,0" Background="{DynamicResource Line}"/>
            <DockPanel Margin="16,12"><Border DockPanel.Dock="Right"><Button x:Name="BreezeSettings" Content="配置 API 密钥" Style="{StaticResource ShelfAction}"/></Border><TextBlock Text="BreezeBlue 云端语音" VerticalAlignment="Center"/></DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ShortcutsPage" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Margin="32,25" HorizontalAlignment="Stretch">
        <Button x:Name="BackToSettings" Content="‹ 返回设置" HorizontalAlignment="Left" Style="{StaticResource ShelfAction}" />
        <DockPanel Margin="0,12,0,20">
          <Button x:Name="ResetShortcuts" DockPanel.Dock="Right" Content="恢复默认" VerticalAlignment="Center" Style="{StaticResource ShelfAction}" />
          <TextBlock Text="快捷键" FontFamily="SimSun" FontWeight="SemiBold" FontSize="36"/>
        </DockPanel>
        <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
          <ItemsControl x:Name="ShortcutBindings">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="16,7">
                  <Button DockPanel.Dock="Right" Width="164" Content="{Binding KeyLabel}" Style="{StaticResource ShelfAction}"
                          automation:AutomationProperties.Name="{Binding Label, StringFormat=修改{0}的快捷键}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock Text="点击当前键位，再按下新键位。" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="NoticeBox" Grid.Row="0" Background="{DynamicResource NoticeFill}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="8" Padding="13,8"
            Visibility="Collapsed" VerticalAlignment="Bottom" Margin="27,0,27,10" IsHitTestVisible="False">
      <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource NoticeText}" FontSize="12" />
    </Border>

    <Border x:Name="PlayerBar" Grid.Row="1" Height="113" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,11,25,9">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
          <TextBlock Text="全书进度" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
          <ProgressBar x:Name="Progress" Grid.Column="1" Height="5" Value="0" Maximum="100" Background="{DynamicResource Soft}" Foreground="{DynamicResource AccentLine}" BorderThickness="0"
                       automation:AutomationProperties.Name="全书进度" />
          <TextBlock x:Name="ProgressPercent" Grid.Column="2" Text="0%" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
        </Grid>
        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,7,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="247"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="PlayerTitle" Text="等待导入" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            <TextBlock x:Name="PlayerStatus" Text="导入电子书后即可朗读" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="PreviousChapter" Style="{StaticResource Transport}" ToolTip="上一章" automation:AutomationProperties.Name="上一章">
              <Path Fill="{DynamicResource Accent}" Data="M 1,2 H 3 V 16 H 1 Z M 16,2 L 5,9 L 16,16 Z" />
            </Button>
            <Button x:Name="Play" Style="{StaticResource PrimaryButton}" Width="106" Height="44" Margin="9,0" Padding="9,6">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="PlayGlyph" Width="13" Height="14" Fill="{DynamicResource PrimaryText}" Stretch="Uniform" VerticalAlignment="Center" Data="M 1,0 L 14,7 L 1,14 Z" />
                <TextBlock x:Name="PlayLabel" Text="朗读" Foreground="{DynamicResource PrimaryText}" Margin="7,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="NextChapter" Style="{StaticResource Transport}" ToolTip="下一章" automation:AutomationProperties.Name="下一章">
              <Path Fill="{DynamicResource Accent}" Data="M 14,2 H 16 V 16 H 14 Z M 1,2 L 12,9 L 1,16 Z" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Button x:Name="RevealPlayer" Grid.Row="1" Height="14" Visibility="Collapsed" Padding="0"
            Style="{StaticResource BaseButton}" BorderThickness="0" ToolTip="显示播放栏"
            automation:AutomationProperties.Name="显示播放栏">
      <Border Width="30" Height="2" CornerRadius="1" Background="{DynamicResource AccentLine}" Opacity="0.65"/>
    </Button>
    </Grid>
    <Grid x:Name="BookOpeningLayer" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
          Background="Transparent" ClipToBounds="True"/>
  </Grid>
</Window>
